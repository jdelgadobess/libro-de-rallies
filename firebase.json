{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [
      { "source": "/kml/**", "function": { "functionId": "kml", "region": "europe-west1" } }
    ],
    "headers": [
      { "source": "**/*.@(js|css|html)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "functions": [{ "source": "functions", "codebase": "default", "runtime": "nodejs22" }],
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" }
}
