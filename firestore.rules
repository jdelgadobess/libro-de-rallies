rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownerDoc() { return /databases/$(database)/documents/config/owner; }
    function isOwner() { return signedIn() && exists(ownerDoc()) && get(ownerDoc()).data.uid == request.auth.uid; }
    function email() { return request.auth.token.email.lower(); }
    function memberDoc() { return /databases/$(database)/documents/members/$(email()); }
    function role() { return exists(memberDoc()) ? get(memberDoc()).data.role : ''; }
    function isAdmin() { return isOwner() || (signedIn() && role() == 'admin'); }
    function canEdit() { return isAdmin() || (signedIn() && role() == 'editor'); }
    function canRead() { return canEdit() || (signedIn() && role() == 'viewer'); }

    // The first person to sign in claims the site; nobody can change it afterwards.
    match /config/owner {
      allow read: if signedIn();
      allow create: if signedIn() && !exists(ownerDoc()) && request.resource.data.uid == request.auth.uid;
    }
    match /config/feed {
      allow read, write: if isAdmin();
    }
    match /members/{member} {
      allow read: if isAdmin() || (signedIn() && member == email());
      allow write: if isAdmin() && member == member.lower()
        && (request.method == 'delete' || request.resource.data.role in ['admin', 'editor', 'viewer']);
    }
    match /rallies/{id} {
      allow read: if canRead();
      allow write: if canEdit();
    }
    match /waypoints/{id} {
      allow read: if canRead();
      allow write: if canEdit();
    }
  }
}
